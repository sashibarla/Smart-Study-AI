# ==========================================
# SMART STUDY AI ASSISTANT - ENV CONFIG
# ==========================================

# Secret key for JWT session authentication
SECRET_KEY=your_jwt_secret_key_here

# Optional production database connection URL (e.g. Postgres / Supabase / Neon)
# If left blank, SQLite is automatically used
DATABASE_URL=

# Optional CORS Allowed Origins (comma-separated domains or * for all)
ALLOWED_ORIGINS=*

# (Optional) Google Gemini API Key
# If not provided, the application seamlessly runs on its built-in CSE Academic NLP Engine!
GEMINI_API_KEY=

# (Optional) OpenAI API Key
OPENAI_API_KEY=

# AI Provider Mode: auto, gemini, openai, built-in
DEFAULT_AI_PROVIDER=auto

# Frontend API URL (for local dev: http://127.0.0.1:8000/api or production backend URL)
VITE_API_URL=http://127.0.0.1:8000/api
